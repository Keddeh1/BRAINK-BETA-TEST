[Unit]
Description=BRAINK development application node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/braink-development/runtime.env
ExecStart=${BRAINK_RUNTIME_ROOT}/venv/bin/python ${BRAINK_NODE_SOURCE}/scripts/supervise_node.py --runtime-root ${BRAINK_RUNTIME_ROOT} --source ${BRAINK_NODE_SOURCE} --checkout ${BRAINK_SOURCE_CHECKOUT} --owner-export ${BRAINK_OWNER_IL_LLM_EXPORT} --mesh-token-file ${BRAINK_MESH_TOKEN_FILE}
Restart=on-failure
RestartSec=3
KillMode=control-group

[Install]
WantedBy=multi-user.target
